{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "brain",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@napkin/brain",
        "dev"
      ],
      "port": 4000
    },
    {
      "name": "owner",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@napkin/owner",
        "dev"
      ],
      "port": 3001
    },
    {
      "name": "store",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@napkin/store",
        "dev"
      ],
      "port": 3002
    },
    {
      "name": "store-cloud",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@napkin/store",
        "dev"
      ],
      "port": 3002,
      "env": {
        "NEXT_PUBLIC_SPACETIMEDB_URI": "wss://maincloud.spacetimedb.com",
        "NEXT_PUBLIC_SPACETIMEDB_DB": "napkin-inc-mayas",
        "NEXT_PUBLIC_BRAIN_URL": "http://localhost:4000",
        "NEXT_PUBLIC_STORE_URL": "http://localhost:3002"
      }
    }
  ]
}