          "id": "refund.contra",
          "scope": "doc",
          "target": {
            "kind": "account",
            "code": "4200"
          },
          "side": "debit",
          "amountExpr": "doc.amount - doc.taxBack",
          "memo": "refund to customer"
        },
        {
          "id": "refund.tax",
          "scope": "doc",
          "target": {
            "kind": "account",
            "code": "2100"
          },
          "side": "debit",
          "amountExpr": "doc.taxBack",
          "memo": "sales tax returned with the refund"
        },
        {
          "id": "refund.clearing",
          "scope": "doc",
          "target": {
            "kind": "account",
            "code": "1010"
          },
          "side": "credit",
          "amountExpr": "doc.amount",
          "memo": "refund paid from Stripe clearing"
        }
      ]
