          "required": true
        },
        {
          "name": "hoursSinceSale",
          "type": "number",
          "required": true
        }
      ],
      "lineFields": [],
      "derived": [
        {
          "name": "refundedAfter",
          "scope": "doc",
          "expr": "doc.refundedSoFar + doc.amount"
        },
        {
          "name": "retained",
          "scope": "doc",
          "expr": "doc.saleNet - doc.refundedAfter"
        },
        {
          "name": "taxShare",
          "scope": "doc",
          "expr": "(doc.saleTotal - doc.saleNet) / max(doc.saleTotal, 0.01)"
        },
        {
          "name": "taxBack",
          "scope": "doc",
          "expr": "round2(doc.refundedAfter * doc.taxShare) - round2(doc.refundedSoFar * doc.taxShare)"
        }
      ],
      "checks": [
        {
          "id": "refund_positive",
          "scope": "doc",
          "assert": "doc.amount > 0",
          "message": "refund amount must be positive"
        },
        {
          "id": "refund_window",
          "scope": "doc",
          "assert": "doc.hoursSinceSale <= policy.refundWindowHours",
          "message": "the refund window has passed"
        },
        {
          "id": "refund_not_over",
          "scope": "doc",
          "assert": "doc.refundedAfter <= doc.saleTotal",
          "message": "refunds cannot exceed what was paid"
        },
        {
          "id": "refund_full_or_floor",
          "scope": "doc",
          "assert": "doc.refundedAfter == doc.saleTotal || doc.retained >= doc.saleCost * (1 + policy.marginFloor)",
          "message": "a partial refund cannot take the sale below cost plus the margin floor; refund in full instead"
        }
      ],
      "postingRules": [
