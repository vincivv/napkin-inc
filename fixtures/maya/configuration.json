            "kind": "register",
            "id": "stock",
            "dims": {
              "item": "line.stockItem"
            }
          },
          "side": "out",
          "amountExpr": "line.cost",
          "qtyExpr": "line.units",
          "when": "line.units > 0"
        },
        {
          "id": "sale.by_product",
          "scope": "line",
          "target": {
            "kind": "register",
            "id": "sales",
            "dims": {
