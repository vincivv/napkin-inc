          "type": "qty",
          "required": true
        }
      ],
      "derived": [
        {
          "name": "gross",
          "scope": "line",
          "expr": "line.qty * line.unitPrice"
        },
        {
          "name": "discount",
          "scope": "line",
          "expr": "round2(line.gross * doc.discountRate)"
        },
        {
          "name": "net",
          "scope": "line",
          "expr": "line.gross - line.discount"
        },
        {
          "name": "tax",
          "scope": "line",
          "expr": "round2(line.net * policy.taxRate)"
        },
        {
          "name": "cost",
          "scope": "line",
          "expr": "line.qty * line.unitCost"
        },
        {
          "name": "units",
          "scope": "line",
          "expr": "line.qty * line.stockUnits"
        },
        {
          "name": "total",
          "scope": "doc",
          "expr": "sum(line.net + line.tax)"
        },
        {
          "name": "costTotal",
          "scope": "doc",
          "expr": "sum(line.cost)"
        }
      ],
      "checks": [
        {
          "id": "qty_positive",
          "scope": "line",
          "assert": "line.qty >= 1",
          "message": "quantity must be at least 1"
        },
        {
          "id": "discount_cap",
          "scope": "doc",
          "assert": "doc.discountRate >= 0 && doc.discountRate <= policy.maxDiscount",
          "message": "total discount exceeds the maximum discount policy"
        },
        {
          "id": "margin_floor",
          "scope": "line",
          "assert": "line.net >= line.cost * (1 + policy.marginFloor)",
          "message": "price after discounts is below cost plus the margin floor"
        }
      ],
