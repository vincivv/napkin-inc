      "approval": {
        "creatorRoles": [
          "owner"
        ],
        "approverRoles": [
          "owner"
        ],
        "cannotApproveOwn": false,
        "postOn": "create",
        "note": "recorded by the owner only (AI staff never), optionally pre-filled from a receipt photo the owner checks; line.account is the expense account code, doc.paidFrom is 1000 (paid now) or 2000 (owed to the supplier)"
      },
      "fields": [
        {
          "name": "vendor",
          "type": "string"
        },
        {
          "name": "date",
          "type": "string",
          "required": true
        },
        {
          "name": "paidFrom",
          "type": "number",
          "required": true
        },
        {
          "name": "receiptRef",
          "type": "string"
        }
      ],
      "lineFields": [
        {
          "name": "account",
          "type": "number",
          "required": true
        },
        {
          "name": "amount",
          "type": "money",
          "required": true
        },
        {
          "name": "description",
          "type": "string"
        }
      ],
      "derived": [
        {
          "name": "total",
          "scope": "doc",
          "expr": "sum(line.amount)"
        }
      ],
      "checks": [
        {
          "id": "amount_positive",
          "scope": "line",
          "assert": "line.amount > 0",
          "message": "each expense amount must be positive"
        },
        {
          "id": "expense_account",
          "scope": "line",
          "assert": "line.account == 6000 || line.account == 6100 || line.account == 6200 || line.account == 6300 || line.account == 6900",
          "message": "an expense can only be booked to an expense account (6000 Rent, 6100 Supplies, 6200 Wages, 6300 Utilities, 6900 Other expenses)"
        },
        {
          "id": "total_positive",
          "scope": "doc",
          "assert": "doc.total > 0",
          "message": "an expense needs at least one amount"
        },
        {
          "id": "paid_from",
          "scope": "doc",
          "assert": "doc.paidFrom == 1000 || doc.paidFrom == 2000",
          "message": "an expense is either paid now (1000) or owed to the supplier (2000)"
        }
      ],
      "postingRules": [
        {
          "id": "expense.rent",
          "scope": "line",
          "target": {
            "kind": "account",
            "code": "6000"
          },
          "side": "debit",
          "amountExpr": "line.amount",
          "when": "line.account == 6000",
          "memo": "rent"
        },
        {
          "id": "expense.supplies",
          "scope": "line",
          "target": {
            "kind": "account",
            "code": "6100"
          },
          "side": "debit",
          "amountExpr": "line.amount",
          "when": "line.account == 6100",
          "memo": "supplies"
        },
        {
          "id": "expense.wages",
          "scope": "line",
          "target": {
            "kind": "account",
            "code": "6200"
          },
          "side": "debit",
          "amountExpr": "line.amount",
          "when": "line.account == 6200",
          "memo": "wages"
        },
        {
          "id": "expense.utilities",
          "scope": "line",
          "target": {
            "kind": "account",
            "code": "6300"
          },
          "side": "debit",
          "amountExpr": "line.amount",
          "when": "line.account == 6300",
          "memo": "utilities"
        },
        {
          "id": "expense.other",
          "scope": "line",
          "target": {
            "kind": "account",
            "code": "6900"
          },
          "side": "debit",
          "amountExpr": "line.amount",
          "when": "line.account == 6900",
          "memo": "other expenses"
        },
        {
          "id": "expense.cash",
          "scope": "doc",
          "target": {
            "kind": "account",
            "code": "1000"
          },
          "side": "credit",
          "amountExpr": "doc.total",
          "when": "doc.paidFrom == 1000",
          "memo": "paid now"
        },
        {
          "id": "expense.payable",
          "scope": "doc",
          "target": {
            "kind": "account",
            "code": "2000"
          },
          "side": "credit",
          "amountExpr": "doc.total",
          "when": "doc.paidFrom == 2000",
          "memo": "owed to supplier"
        }
      ]
    },
    {
      "id": "stock_added",
      "name": "Stock added",
      "approval": {
        "creatorRoles": [
          "owner"
        ],
        "approverRoles": [
          "owner"
        ],
        "cannotApproveOwn": false,
        "postOn": "create",
        "note": "the owner adds stock by hand (a delivery, a fresh batch); doc.paidFrom is 1000 paid now, 2000 owed to the supplier or 3000 put in by the owner"
      },
      "fields": [
        {
          "name": "supplier",
          "type": "string"
        },
        {
          "name": "paidFrom",
          "type": "number",
          "required": true
        }
      ],
      "lineFields": [
        {
          "name": "stockItem",
          "type": "string",
          "required": true
        },
        {
          "name": "qty",
          "type": "qty",
          "required": true
        },
        {
          "name": "unitCost",
          "type": "money",
          "required": true
        }
      ],
      "derived": [
        {
          "name": "value",
          "scope": "line",
          "expr": "line.qty * line.unitCost"
        }
      ],
      "checks": [
        {
          "id": "qty_positive",
          "scope": "line",
          "assert": "line.qty >= 1",
          "message": "quantity must be at least 1"
        },
        {
          "id": "cost_nonneg",
          "scope": "line",
          "assert": "line.unitCost >= 0",
          "message": "unit cost cannot be negative"
        },
        {
          "id": "paid_from",
          "scope": "doc",
          "assert": "doc.paidFrom == 1000 || doc.paidFrom == 2000 || doc.paidFrom == 3000",
          "message": "added stock is paid now (1000), owed to the supplier (2000) or put in by the owner (3000)"
        }
      ],
      "postingRules": [
        {
          "id": "added.inventory",
          "scope": "line",
          "target": {
            "kind": "account",
            "code": "1300"
          },
          "side": "debit",
          "amountExpr": "line.value",
          "memo": "stock added"
        },
        {
          "id": "added.cash",
          "scope": "line",
          "target": {
            "kind": "account",
            "code": "1000"
          },
          "side": "credit",
          "amountExpr": "line.value",
          "when": "doc.paidFrom == 1000",
          "memo": "paid now"
        },
        {
          "id": "added.payable",
          "scope": "line",
          "target": {
            "kind": "account",
            "code": "2000"
          },
          "side": "credit",
          "amountExpr": "line.value",
          "when": "doc.paidFrom == 2000",
          "memo": "owed to supplier"
        },
        {
          "id": "added.owner",
          "scope": "line",
          "target": {
            "kind": "account",
            "code": "3000"
          },
          "side": "credit",
          "amountExpr": "line.value",
          "when": "doc.paidFrom == 3000",
          "memo": "put in by the owner"
        },
        {
          "id": "added.stock_in",
          "scope": "line",
          "target": {
            "kind": "register",
            "id": "stock",
            "dims": {
              "item": "line.stockItem"
            }
          },
          "side": "in",
          "amountExpr": "line.value",
          "qtyExpr": "line.qty"
        }
      ]
    },
    {
      "id": "stock_removed",
      "name": "Stock removed",
      "approval": {
        "creatorRoles": [
          "owner"
        ],
        "approverRoles": [
          "owner"
        ],
        "cannotApproveOwn": false,
        "postOn": "create",
        "note": "the owner takes stock out by hand (spoiled, broken, given away, a recount); written off at its unit cost"
      },
      "fields": [
        {
          "name": "reason",
          "type": "string",
          "required": true
        }
      ],
      "lineFields": [
        {
          "name": "stockItem",
          "type": "string",
          "required": true
        },
        {
          "name": "qty",
          "type": "qty",
          "required": true
        },
        {
          "name": "unitCost",
          "type": "money",
          "required": true
        }
      ],
      "derived": [
        {
          "name": "value",
          "scope": "line",
          "expr": "line.qty * line.unitCost"
        }
      ],
      "checks": [
        {
          "id": "qty_positive",
          "scope": "line",
          "assert": "line.qty >= 1",
          "message": "quantity must be at least 1"
        },
        {
          "id": "cost_nonneg",
          "scope": "line",
          "assert": "line.unitCost >= 0",
          "message": "unit cost cannot be negative"
        }
      ],
      "postingRules": [
        {
          "id": "removed.write_off",
          "scope": "line",
          "target": {
            "kind": "account",
            "code": "5200"
          },
          "side": "debit",
          "amountExpr": "line.value",
          "memo": "stock written off"
        },
        {
          "id": "removed.inventory",
          "scope": "line",
          "target": {
            "kind": "account",
            "code": "1300"
          },
          "side": "credit",
          "amountExpr": "line.value",
          "memo": "stock removed"
        },
        {
          "id": "removed.stock_out",
          "scope": "line",
          "target": {
            "kind": "register",
            "id": "stock",
            "dims": {
              "item": "line.stockItem"
            }
          },
          "side": "out",
          "amountExpr": "line.value",
          "qtyExpr": "line.qty"
        }
      ]
    }
  ],
