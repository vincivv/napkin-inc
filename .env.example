# Napkin Inc. — copy to .env and fill in. Never commit .env.
# Anthropic (claude-opus-5-5 intake/compiler, claude-sonnet-5-5 staff, claude-haiku-5-5 classification)
ANTHROPIC_API_KEY=
# Only if your key is not scoped to a workspace (the API then demands an anthropic-workspace-id header)
ANTHROPIC_WORKSPACE_ID=
# Cartesia (speech-to-text for intake, voice for the phone line)
CARTESIA_API_KEY=
# Stripe TEST MODE ONLY (sk_test_...). The brain refuses to start with a live key.
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:4000/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=
# SpacetimeDB
SPACETIMEDB_URI=http://localhost:3000
SPACETIMEDB_DB=napkin
# Telephony (filled in once the phone-line approach is approved)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Owner mode on the phone line
OWNER_PHONE=
OWNER_PIN=
# Public URLs (QR codes and payment links point here)
STORE_PUBLIC_URL=http://localhost:3002
OWNER_APP_URL=http://localhost:3001
BRAIN_URL=http://localhost:4000
