# Napkin Inc. — copy to .env and fill in. Never commit .env.
# Anthropic (claude-opus-5-5 intake/compiler, claude-sonnet-5-5 staff, claude-haiku-5-5 classification)
ANTHROPIC_API_KEY=
# Only if your key is not scoped to a workspace (the API then demands an anthropic-workspace-id header)
ANTHROPIC_WORKSPACE_ID=
# Cartesia (speech-to-text for intake, voice for the phone line)
CARTESIA_API_KEY=
# Stripe TEST MODE ONLY (sk_test_...). The brain refuses to start with a live key.
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:4000/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=
# SpacetimeDB
SPACETIMEDB_URI=http://localhost:3000
SPACETIMEDB_DB=napkin
# Phone line (Cartesia Managed Agent -> brain webhook tools). Bearer secret every /phone/tools call must send.
# At least 24 characters; unset or shorter = every phone tool call is refused (401). e.g. `openssl rand -hex 32`
PHONE_TOOL_SECRET=
# The business the phone line answers for
PHONE_BUSINESS_ID=maya-cookies
# SMS for phone-order payment links (Twilio trial: verify each recipient number first).
# Absent = SMS SIMULATOR (logs only, nothing is sent). TWILIO_PHONE_NUMBER is the E.164 "From" number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Owner mode on the phone line: caller ID must equal OWNER_PHONE (E.164, e.g. +14155550123) AND the PIN must match
OWNER_PHONE=
OWNER_PIN=
# Public URLs (QR codes and payment links point here). For the phone line, BRAIN_URL must be the public tunnel URL.
STORE_PUBLIC_URL=http://localhost:3002
OWNER_APP_URL=http://localhost:3001
BRAIN_URL=http://localhost:4000

# Optional: seed an owner-app login for the demo business (maya-cookies) on brain start
MAYA_ACCOUNT_EMAIL=
MAYA_ACCOUNT_PASSWORD=
