  {
    "id": "CH-04",
    "kind": "crash",
    "title": "Brain crashes after createOrder, before the Stripe checkout session",
    "steps": [
      { "op": "crash_at", "point": "after_create_order_before_stripe_session" },
      { "op": "create_order", "orderId": "MC-CH04A", "items": [{ "productId": "cookie_single", "qty": 2 }] },
      { "op": "restart_brain" },
      { "op": "start_checkout", "orderId": "MC-CH04A" },
      { "op": "drain_outbox" }
    ],
    "expected": {
      "orderStatus": { "MC-CH04A": "pending_payment" },
      "stripe": { "checkoutSessions": 1 },
      "paymentIntents": { "MC-CH04A": 1 },
      "journalBalanced": true
    },
    "safeBehavior": "After the restart the order exists once, its payment intent is logged once, and exactly one Stripe checkout session is created when checkout is retried. No duplicate order or session appears.",
    "invariantIds": [7, 1]
  },
  {
