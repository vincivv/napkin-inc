      { "op": "crash_at", "point": "after_stripe_session_before_attach" },
      { "op": "start_checkout", "orderId": "MC-CH05A" },
      { "op": "restart_brain" },
      { "op": "start_checkout", "orderId": "MC-CH05A" },
      { "op": "drain_outbox" }
    ],
    "expected": {
      "orderStatus": { "MC-CH05A": "pending_payment" },
      "stripe": { "checkoutSessions": 1 },
      "paymentIntents": { "MC-CH05A": 1 },
      "journalBalanced": true
    },
    "safeBehavior": "The session created before the crash is found by its idempotency key on retry and attached, so Stripe shows one checkout session for MC-CH05A. Retrying does not create a second one.",
