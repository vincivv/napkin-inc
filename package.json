{
  "name": "napkin-inc",
  "private": true,
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "stdb": "spacetime start --listen-addr 127.0.0.1:3000",
    "publish:local": "pnpm --filter @napkin/platform publish && pnpm --filter @napkin/platform generate",
    "bootstrap": "pnpm --filter @napkin/brain bootstrap"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
